# openscad-mcp configuration via environment variables.
# Copy to .env (loaded automatically) or export in the service environment.
# Every variable is optional; defaults are shown. The same settings can be
# given in a YAML file (see README "Configuration").

# --- OpenSCAD binary -------------------------------------------------------
# Auto-detected on PATH and in common install locations (stable and
# openscad-nightly); set explicitly to override.
#OPENSCAD_PATH=/usr/bin/openscad

# --- Transport --------------------------------------------------------------
# stdio (default, per-client) | http | sse
#MCP_TRANSPORT=stdio
#MCP_HOST=localhost
#MCP_PORT=8000

# --- Rendering --------------------------------------------------------------
# Concurrent OpenSCAD processes (applies to renders, exports and checks).
#MCP_MAX_CONCURRENT_RENDERS=5
# Per-process timeout in seconds.
#MCP_RENDER_TIMEOUT=300
# Requested image sizes are clamped to these (aspect preserved). 1568 px is
# the long-edge limit above which vision models downscale anyway.
#MCP_MAX_IMAGE_WIDTH=1568
#MCP_MAX_IMAGE_HEIGHT=1568
# Pass --hardwarnings to OpenSCAD. Off by default: on 2021.01 it stops
# evaluation at the first warning while still exiting 0, which blanks renders
# and truncates echo output. Warnings reach the assistant via diagnostics.
#MCP_HARD_WARNINGS=false

# --- Cache ------------------------------------------------------------------
# Renders (with dependency manifests) and per-part meshes/CSG dumps live under
# ~/.cache/openscad-mcp; clear with the clear_cache tool.
#MCP_CACHE_ENABLED=true
#MCP_CACHE_SIZE_MB=500
#MCP_CACHE_TTL_HOURS=24
# Working directory for temporary files and inline models.
#MCP_TEMP_DIR=/tmp/openscad-mcp

# --- Security ---------------------------------------------------------------
# Directories scripts may read from, os.pathsep-separated (":" on POSIX).
# Unset = no path validation at all (a warning is logged at startup). When
# set, every file OpenSCAD reads (include/use/import/surface) is checked and
# output is withheld on a violation.
#MCP_ALLOWED_PATHS=/home/me/projects/parts:/home/me/projects/lib
# Address-space limit per OpenSCAD process on POSIX hosts (RLIMIT_AS); 0
# disables. OpenSCAD has no ceiling of its own.
#MCP_MAX_MEMORY_MB=4096
# Maximum inline .scad content accepted, in MB.
#MCP_MAX_FILE_SIZE_MB=10
# Requests per minute (0 disables).
#MCP_RATE_LIMIT=60

# --- Logging ----------------------------------------------------------------
#MCP_LOG_LEVEL=INFO
#MCP_LOG_FILE=/var/log/openscad-mcp.log
